{
  "purpose": "Course submission only; distinct from the private engineering snapshot",
  "max_archive_bytes": 50000000,
  "source_patterns": [
    "README.md",
    "requirements/requirements*.txt",
    "src/**/*.py",
    "formal_src/**/*.py",
    "app/**/*.py",
    "web/*.html",
    "web/*.css",
    "web/*.js",
    "scripts/*.py",
    "tests/**/*.py",
    "tests/web/*.cjs",
    "configs/formal/*.json",
    "configs/examples/*",
    "docs/guides/APP_GUIDE.md",
    "docs/delivery/COURSE_SUBMISSION_MANIFEST.json",
    "docs/delivery/COURSE_README.md"
  ],
  "required_documents": [
    "course/报告.pdf",
    "course/项目摘要.md",
    "course/submission.json",
    "course/AI使用声明.md",
    "docs/delivery/COURSE_README.md",
    "docs/guides/APP_GUIDE.md"
  ],
  "submission_fields": [
    "leader_id",
    "leader_name",
    "project_name",
    "members"
  ],
  "resource_policy": "No datasets, full requests, gold, weights, videos, virtual environments or credentials. External resources are referenced by content SHA."
}
