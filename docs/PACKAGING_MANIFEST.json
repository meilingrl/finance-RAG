{
  "purpose": "Private runnable engineering snapshot, not a coursework submission ZIP",
  "archive_root": "rag-pilot",
  "max_archive_bytes": 50000000,
  "include": [
    "README.md",
    "PILOT_STATUS.md",
    "config.example.yaml",
    "config.llm.example.json",
    ".gitignore",
    "requirements*.txt",
    "src/**/*.py",
    "tests/**/*.py",
    "scripts/*.py",
    "docs/**/*",
    "source-docs/**/*",
    "artifacts/*.json",
    "artifacts/test-results.txt",
    "artifacts/development/**/*",
    "artifacts/development-k-check/**/*",
    "artifacts/pilot-evaluation/**/*",
    "artifacts/real-subset/**/*",
    "artifacts/fixture-demo/**/*",
    "artifacts/optional-encoder-check/**/*",
    "artifacts/encoder-provisioning/**/*",
    "artifacts/phase2-visual-review/**/*",
    "artifacts/llm-phase3/**/*",
    "artifacts/llm-phase4/**/*",
    "artifacts/nonllm-phase2/final-v5/**/*",
    "artifacts/nonllm-phase2/independent-audit/**/*",
    "artifacts/nonllm-phase2/RAW_RESULTS.json",
    "artifacts/nonllm-phase2/RAW_COUNTS.csv",
    "artifacts/nonllm-phase2/final-v5-development.log",
    "artifacts/nonllm-phase2/final-v5-evaluation.log",
    "artifacts/nonllm-phase2/fixture-validation.json",
    "data/raw/tatdqa/**/*",
    "data/processed/real-subset/**/*",
    "data/processed/nonllm-pilot-v5/**/*",
    "data/phase2/ACQUISITION.md",
    "data/phase2/PROVENANCE.json",
    "data/phase2/sample_manifest.json",
    "data/phase2/acquisition_validation.json",
    "data/phase2/acquisition.log",
    "data/phase2/gold_sources.json",
    "data/phase2/acquisition_metadata/**/*",
    "data/phase2/inputs/**/*",
    "data/phase2/development/**/*",
    "data/phase2/evaluation/questions.jsonl",
    "data/phase2/isolated_gold/*.jsonl",
    "data/phase2/isolated_gold/*.json",
    "data/phase2/isolated_gold/README.txt",
    "data/phase2/isolated_gold/review/**/*",
    "config.llm.pinaic.json",
    "config.llm.pinaic-sol.json",
    "artifacts/formal-plan-20261023/**/*"
