  "exclude": [
    ".local-secrets/**",
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "config.llm.local.json",
    "**/.execution.lock",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/.DS_Store",
    "**/.git/**",
    "**/.venv/**",
    "**/venv/**",
    "**/*.safetensors",
    "**/*.pt",
    "**/*.pth",
    "**/*.bin",
    "**/*.whl",
    "data/phase2/acquisition_cache/**",
    "data/phase2/isolated_gold/official_metadata/**",
    "artifacts/preliminary/**",
    "data/processed/preliminary-real-subset/**",
    "artifacts/nonllm-phase2/calibration-*/**",
    "artifacts/nonllm-phase2/final/**",
    "data/processed/nonllm-dev-calibration-v2/**",
    "data/processed/nonllm-dev-regions-v3/**",
    "data/processed/nonllm-pilot-v4/**"
  ],
  "omitted_external_resources": [
    "MiniLM model weights and CPU virtual environment remain outside the project; fixed hashes/versions and setup recipe are included.",
    "Full train/dev QA metadata and ZIP-range acquisition caches are omitted; fixed-revision bounded acquisition script and candidate/exclusion provenance are included.",
    "The 16 selected public PDF/OCR inputs and 48 questions/isolated answers are included so core pipeline replay does not need dataset download.",
    "Course submission instructions require datasets and weights omitted; this engineering snapshot must not be submitted unchanged."
  ]
}
